JOB_INTEL_MODE=local
JOB_INTEL_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JOB_INTEL_OPENAI_MODEL=gpt-5-mini-2025-08-07
JOB_INTEL_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
JOB_INTEL_DB=data/job_intel.db
# Public mode also needs .streamlit/secrets.toml and a persistent database volume.
JOB_INTEL_OIDC_ISSUER=https://accounts.google.com
JOB_INTEL_DAILY_FREE_RUNS=20
JOB_INTEL_MAX_ACTIVE_RUNS=3

# Comma-separated verified identity hashes for the public admin view. Empty = no admins.
JOB_INTEL_ADMIN_IDS=
