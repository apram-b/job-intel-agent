# Save outside the repository at /opt/job-intel/worker.env, chmod 600.
JOB_INTEL_IMAGE=ghcr.io/apram-b/job-intel-agent:REPLACE_WITH_COMMIT_SHA
JOB_INTEL_DB_PASSWORD=REPLACE_WITH_RANDOM_HEXADECIMAL_PASSWORD
JOB_INTEL_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Leave prices unset until checked for the exact configured model.
JOB_INTEL_OPENAI_PRICED_MODEL=gpt-5-mini-2025-08-07
JOB_INTEL_OPENAI_INPUT_USD_PER_MILLION=
JOB_INTEL_OPENAI_OUTPUT_USD_PER_MILLION=
JOB_INTEL_ANTHROPIC_PRICED_MODEL=claude-haiku-4-5-20251001
JOB_INTEL_ANTHROPIC_INPUT_USD_PER_MILLION=
JOB_INTEL_ANTHROPIC_OUTPUT_USD_PER_MILLION=
JOB_INTEL_BACKUP_RECIPIENT=
JOB_INTEL_BACKUP_BUCKET=
JOB_INTEL_DEMO_BUCKET=
JOB_INTEL_ALERT_TOPIC=
AWS_DEFAULT_REGION=ap-south-1
# Configure a scoped worker AWS identity separately; never use your administrator keys.
